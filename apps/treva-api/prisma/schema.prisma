generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id              String   @id @default(cuid())
  title           String
  name            String
  slug            String   @unique
  objectType      String?
  image           String?
  status          String   @default("active")
  housesCount     Int      @default(0)
  propertiesCount Int      @default(0)
  reservedCount   Int      @default(0)
  soldCount       Int      @default(0)
  propertyName    String?
  currency        String   @default("Rubels")
  region          String?
  area            String?
  city            String?
  locationTitle         String?
  locationUrl           String?
  locationGoogleMapsUrl String?
  developerBrand  String?
  website         String?
  salesDepartment String?
  phoneNumber     String?
  coverImage      String?
  bannerImage     String?
  documents       Json       @default("[]")
  fedLaw214       Boolean  @default(false)
  type            String   @default("object") // "category" | "object"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  houses      House[]
  unitLayouts UnitLayout[]
}

model House {
  id                          String      @id @default(cuid())
  title                       String
  name                        String
  slug                        String      @unique
  seoTitle                    String?
  seoDescription              String?
  seoKeywords                 String?
  canonicalUrl                String?
  seoImage                    String?
  floor                       Int
  number                      Int?
  totalArea                   Float
  internalArea                Float
  balconyArea                 Float?
  prices                      Json        @default("{}")
  completionYear              Int
  numberOfFloors              Json
  similarApartmentIds         String[]
  mainImage                   Json?
  coverImage                  Json?
  gallery                     Json[]
  documents                   Json[]
  location                    Json?
  categoryId                  String
  category                    Category    @relation(fields: [categoryId], references: [id])
  status                      String      @default("available")
  statusOptionId              String?
  statusOption                StatusOption? @relation(fields: [statusOptionId], references: [id])
  typeOfBuilding              String?
  constructionStage           String?
  description                 String?
  ownerId                     String?
  owner                       Owner?      @relation(fields: [ownerId], references: [id])
  heatingTypeIds              String[]    @default([])
  attributeIds                String[]    @default([])
  locationTitle               String?
  locationUrl                 String?
  locationGoogleMapsUrl       String?
  street                      String?
  houseNumber                 String?
  deadlineForCommissioning    String?
  salesOffice                 String?
  landCadastralNumber         String?
  contractAddress             String?
  secondContractAddress       String?
  showroomAvailability        String?
  secondShowroomAvailability  String?
  archived                    Boolean     @default(false)
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  unitLayouts                 UnitLayout[]
}

model UnitLayout {
  id                          String      @id @default(cuid())
  title                       String
  name                        String
  slug                        String      @unique
  seoTitle                    String?
  seoDescription              String?
  seoKeywords                 String?
  canonicalUrl                String?
  seoImage                    String?
  floor                       Int
  number                      Int?
  entrance                    String?
  totalArea                   Float
  internalArea                Float
  balconyArea                 Float?
  prices                      Json         @default("{}")
  completionYear              Int
  numberOfFloors              Json
  similarApartmentIds         String[]
  mainImage                   Json?
  coverImage                  Json?
  gallery                     Json[]
  documents                   Json[]
  categoryId                  String
  category                    Category    @relation(fields: [categoryId], references: [id])
  houseId                     String?
  house                       House?      @relation(fields: [houseId], references: [id], onDelete: SetNull)
  unitTypeOptionId            String?
  unitTypeOption              UnitTypeOption? @relation(fields: [unitTypeOptionId], references: [id])
  realEstateType              String?
  status                      String       @default("available")
  statusOptionId              String?
  statusOption                StatusOption? @relation(fields: [statusOptionId], references: [id])
  typeOfBuilding              String?
  constructionStage           String?
  description                 String?
  heatingTypeIds              String[]    @default([])
  attributeIds                String[]    @default([])
  archived                    Boolean     @default(false)
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
}

model UnitTypeOption {
  id        String   @id @default(cuid())
  name      String   @unique
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unitLayouts UnitLayout[]
}

model Currency {
  id              String           @id @default(cuid())
  name            String           @unique
  title           String
  value           String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  apartmentPrices ApartmentPrice[]
}

model StatusOption {
  id        String   @id @default(cuid())
  value     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  houses      House[]
  unitLayouts UnitLayout[]
}

model LcdOption {
  id        String   @id @default(cuid())
  value     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TypeOfBuildingOption {
  id        String   @id @default(cuid())
  value     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PropertyTypeOption {
  id        String   @id @default(cuid())
  value     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConstructionStageOption {
  id        String   @id @default(cuid())
  value     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Resale Models ───────────────────────────────────────────

model ApartmentType {
  id        String   @id @default(cuid())
  name      String   @unique
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apartments Apartment[]
}

model Owner {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  profession  String?
  phoneNumber String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  apartments  Apartment[]
  houses      House[]
}

model Attribute {
  id        String   @id @default(cuid())
  name      String
  title     String
  value     String
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Request {
  id          String   @id @default(cuid())
  fullName    String
  phoneNumber String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Apartment {
  id              String        @id @default(cuid())
  name            String?
  title           String
  slug            String        @unique
  description     String?
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?
  canonicalUrl    String?
  seoImage        String?
  image           String?
  coverImage      String?
  gallery         Json[]
  priceTotal      Float         @default(0)
  priceByArea     Float         @default(0)
  roomCount       Int
  area            Float
  grossArea       Float?
  floorFrom       Int
  floorTo         Int
  bathroomCount   Int?
  purpose         String        @default("sale")
  region          String?
  city            String?
  locationTitle   String?
  locationUrl     String?
  locationGoogleMapsUrl String?
  renovation      String?
  mortgage        Boolean?
  extract         Boolean?
  buildingAge     Int?
  furnishing      String?
  ceilingHeight   Float?
  kitchenSize     Float?
  wallMaterial    String?
  heatingTypeIds  String[]      @default([])
  attributeIds    String[]
  requestIds      String[]
  status          String        @default("active")
  archived        Boolean       @default(false)
  apartmentTypeId String
  apartmentType   ApartmentType  @relation(fields: [apartmentTypeId], references: [id])
  ownerId         String?
  owner           Owner?         @relation(fields: [ownerId], references: [id])
  prices          ApartmentPrice[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model LocationOption {
  id        String   @id @default(cuid())
  type      String
  name      String
  title     String
  cityId    String?
  city      LocationOption?  @relation("CityRegions", fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  regions   LocationOption[] @relation("CityRegions")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, name])
  @@index([cityId])
}

model HeatingTypeOption {
  id        String   @id @default(cuid())
  name      String   @unique
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApartmentPrice {
  id          String   @id @default(cuid())
  apartmentId String
  currencyId  String
  priceTotal  Float
  priceByArea Float
  currency    Currency @relation(fields: [currencyId], references: [id])
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@unique([apartmentId, currencyId])
}
