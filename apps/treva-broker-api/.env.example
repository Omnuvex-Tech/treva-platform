DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/treva_broker?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRATION="7d"
PORT="10041"
API_PREFIX="api/v1"
CORS_ORIGINS="http://localhost:10040"
SWAGGER_PATH="api/docs"
# The first account on a fresh database (prisma/seed.ts). Change the password after the first sign-in.
ADMIN_EMAIL="info@treva.realestate"
ADMIN_PASSWORD="change-me"
# treva-api, the source the Synchronize button copies off-plan projects and units from
TREVA_API_URL="http://localhost:10011/api/v1"

# Bitrix24 — a registered client is looked up among Bitrix contacts by phone and
# email. New: a contact and a deal in "Сделки от агентов" are created. Known: no
# deal. The panel shows which happened, and the deal's stage from then on.
# An inbound webhook with the "crm" scope, e.g. https://treva.bitrix24.ru/rest/<user>/<secret>/
# It is a secret — put it in .env.local (git-ignored), not in a committed .env file.
# Leave it unset to run without Bitrix: clients stay "pending" and nothing is sent.
# BITRIX_WEBHOOK_URL=""
# Where the deal lands: Воронка продаж (0) / "Сделки от агентов" (UC_I9IBLO).
BITRIX_DEAL_CATEGORY_ID="0"
BITRIX_DEAL_STAGE_ID="UC_I9IBLO"
# Managers the platform takes turns assigning deals to, e.g. "32461,50801"
# (Leyla Bagirzade, Nigar Gasimova). Empty: Bitrix decides — on Treva, bp-327
# on "Сделки от агентов" alternates Leyla/Nigar ~10 min after the deal lands,
# because "Агент (CRM)" is filled; until then the deal sits with the webhook's user.
BITRIX_DEAL_RESPONSIBLE_IDS=""
# The contact's and deal's Source — still to be created in Bitrix.
BITRIX_SOURCE_ID=""
# Deal fields. Агент / Агентство get the broker's name and agency, ОТ АГЕНТА is
# ticked, Объект интереса gets the project as typed, and the Проект list gets
# the item whose name matches it. Any left empty is skipped.
BITRIX_DEAL_FIELD_AGENT="UF_CRM_1754245045211"
# "Агент (CRM)": the broker's own contact card — found by email/phone, or created
# as a contact of BITRIX_BROKER_CONTACT_TYPE ("PARTNER" = Агенты) under their
# agency's company, which also becomes the deal's company.
BITRIX_DEAL_FIELD_AGENT_CRM="UF_CRM_1755154053"
BITRIX_BROKER_CONTACT_TYPE="PARTNER"
BITRIX_DEAL_FIELD_AGENCY="UF_CRM_1754245028093"
BITRIX_DEAL_FIELD_FROM_AGENT="UF_CRM_1728075799565"
BITRIX_DEAL_FIELD_OBJECT_OF_INTEREST="UF_CRM_1754245074743"
BITRIX_DEAL_FIELD_PROJECT="UF_CRM_1728071223112"
BITRIX_DEAL_FIELD_PANEL_CLIENT_ID=""
# How old a deal's stage may get before viewing the client re-reads Bitrix.
BITRIX_REFRESH_SECONDS="60"
