NEXT_PUBLIC_APP_NAME="TREVA Broker"
NEXT_PUBLIC_BROKER_API_URL="https://broker-api.treva.realestate/api/v1"
NEXT_PUBLIC_API_TIMEOUT="30000"
NEXT_PUBLIC_USE_MOCK="0"
# Auth only: 0 = sign-in/sign-up against apps/treva-broker-api, even while the rest is mocked
NEXT_PUBLIC_USE_MOCK_AUTH="0"
# News Feed only: 0 = the feed, the editor and uploads against apps/treva-broker-api
NEXT_PUBLIC_USE_MOCK_NEWS="0"
# Clients only: 0 = the list, lead form, edit and delete against apps/treva-broker-api
NEXT_PUBLIC_USE_MOCK_CLIENTS="0"
# Broker Role only: 0 = the materials library, its uploads, edit and delete against apps/treva-broker-api
NEXT_PUBLIC_USE_MOCK_BROKER_ROLE="0"
# Projects only: 0 = the grid, the editor, its image uploads and delete against apps/treva-broker-api
NEXT_PUBLIC_USE_MOCK_PROJECTS="0"
# Floor Plan only: 0 = Listings and floor plans from the inventory Synchronize copies into apps/treva-broker-api
NEXT_PUBLIC_USE_MOCK_FLOOR_PLAN="0"
# Users only: 0 = the Admin Panel's Users screen, agencies, the agent editor, Profile and delete against apps/treva-broker-api
NEXT_PUBLIC_USE_MOCK_USERS="0"
